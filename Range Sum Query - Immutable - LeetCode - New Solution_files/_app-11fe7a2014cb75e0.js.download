  published
  numChapters
  numItems
  codingChallengeInfo {
    startDate
    containsPremium
    canApplyTimeTravelTicket
  }
  shareEvent {
    startDate
    endDate
    hasUserSharedEvent
  }
  valueAddedContent {
    name
    slug
    description
    isActive
    hasAccess
    pricing {
      price
      originalPrice
    }
  }
}
    `,em=`
    fragment DiscussPost on PostNode {
